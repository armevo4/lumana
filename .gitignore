# Secrets — never commit. Generated by scripts/bootstrap-local.sh
# and scripts/gen-overlay-secrets.sh.
.env
local/
k8s/overlays/*/*.env

# Terraform state may contain sensitive values.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Kubeconfigs
kubeconfig*
*.kubeconfig

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editors / OS
.DS_Store
.idea/
.vscode/
